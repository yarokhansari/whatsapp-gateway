# Install once:
#   sudo cp deploy/whatsapp-gateway.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now whatsapp-gateway
# Logs: journalctl -u whatsapp-gateway -f

[Unit]
Description=WhatsApp gateway (Baileys)
After=network-online.target
Wants=network-online.target

[Service]
User=deployer
Group=deployer
WorkingDirectory=/var/www/whatsapp-gateway
ExecStart=/usr/bin/node --env-file=.env src/index.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
