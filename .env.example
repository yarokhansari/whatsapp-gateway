# Copy to .env and fill in. Never commit .env.

# Long random key; apps send it in the "apikey" header. Make one: openssl rand -hex 32
API_KEY=

# Listen only on this server. Apps on this server call http://127.0.0.1:3100
HOST=127.0.0.1
PORT=3100

# One WhatsApp number per instance, comma separated, e.g. automobiles,bakery
INSTANCES=automobiles

# WhatsApp login sessions (private). Delete an instance's folder to link a new phone.
SESSION_DIR=./sessions

# Gap between two messages from one number (ms), and how long a send waits before answering "queued".
SEND_GAP_MS=1500
SEND_WAIT_MS=20000

LOG_LEVEL=info
