{
  "name": "whatsapp-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Small WhatsApp gateway on Baileys: send text messages over a local HTTP API (Evolution API compatible subset).",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "pino": "10.4.0",
    "qrcode": "1.5.4"
  }
}
